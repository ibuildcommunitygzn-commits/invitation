# Copy this file to .env and fill in real values. Never commit .env.

# The public URL this app will be reachable at once deployed.
# Used to build the RSVP link sent in the invite SMS.
# Example: https://invites.yourdomain.com  (no trailing slash)
BASE_URL=http://localhost:3000

# Port the server listens on.
PORT=3000

# Password the admin uses to log into /admin.
# Change this to something strong before deploying.
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me

# Random long string used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# mNotify credentials — from https://app.bms.africa (Developer section)
MNOTIFY_API_KEY=your_mnotify_api_key
# Your approved Sender ID (max 11 characters, shows as who the text is from).
MNOTIFY_SENDER_ID=YourBrand

# Name of the event/host, used in the SMS copy and on the RSVP page.
EVENT_NAME=Our Gathering
